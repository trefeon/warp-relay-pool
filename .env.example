# Copy to .env and adjust. No secrets here — only pool shape and tuning.
#
# Comment syntax: full-line comments start with '#'; after an UNQUOTED value
# a whitespace-preceded '#' also starts an inline comment (e.g.
# `BASE_PORT=3000 # custom`). Quoted values run to the closing quote; a
# comment after the closing quote is ignored.
#
# How these values are consumed:
#   - generate-compose.sh sources this file (when present) at generation
#     time and bakes the relevant values into docker-compose.yml (relay
#     service environment + host binds). After editing, re-run
#     ./generate-compose.sh <count> [--with-tunnels] && docker compose up -d.
#     Values already set in the process environment take precedence.
#   - keep-cold.mjs reads the process environment only. For manual runs use
#     `node --env-file=.env keep-cold.mjs --once`; systemd installs get their
#     values from the unit's Environment= lines (setup.sh writes COUNT
#     there), NOT from this file.

# --- Pool shape ---
# Relay count: generator COUNT, the relay app's RELAY_COUNT, and the
# keep-cold pool size. Relay N listens on BASE_PORT+N; its SOCKS host port
# is 10800+N.
# The setup.sh wizard picks its own count from VPS sizing (pin one with
# `COUNT=5 ./setup.sh`) and intentionally ignores this value, so a copied
# example cannot over-commit a small VPS; manual runs
# (`COUNT=N ./generate-compose.sh`, keep-cold) use it directly. If you
# change it on a wizard-installed host, update the unit's Environment=COUNT
# to match (or re-run setup.sh) — the prober must probe the deployed count.
COUNT=10
# Base port for the relay app's listeners (relay N → BASE_PORT+N). The
# generator derives the tunnel targets, the mesh ingress mapping, and the
# systemd prober's port range from this same value.
BASE_PORT=3000
# Comma-separated allowlist for the x-relay-target header — the relay
# refuses any request whose target is not on this list.
RELAY_ALLOWED_TARGETS=https://opencode.ai,https://api.kilo.ai
# Host binds for the generated compose. Both default to 127.0.0.1 (loopback
# only); set an address explicitly to expose deliberately.
#   WARP_BIND    raw SOCKS5 proxies (10800+N)
#   INGRESS_BIND relay router (3101+; mesh mode only — tunnels mode does not
#                publish it)
# The setup wizard sets INGRESS_BIND to the VPS Tailscale IP in mesh mode.
# WARP_BIND=127.0.0.1
# INGRESS_BIND=127.0.0.1

# --- server.mjs per-relay upstream override (defaults: warp-N:1080) ---
# WARP_HOST_1=warp-1
# WARP_PORT_1=1080

# --- keep-cold probe (keep-cold.mjs) ---
# Address of the relay app as seen from the deploy host.
RELAY_HOST=10.244.0.100
# Host dialed for the SOCKS readiness/egress probes. Keep the default unless
# WARP_BIND is an interface-specific address (then loopback has no listener);
# 0.0.0.0 binds still answer on loopback.
# SOCKS_HOST=127.0.0.1
# Upstream the probes go through (default https://api.kilo.ai — the Kilo
# gateway, keyless-capable and rate-limited per egress; OpenCode's Zen free
# tier refuses non-OpenCode clients outright since 2026-10-14).
PROBE_TARGET=https://api.kilo.ai
PROBE_CHAT_PATH=/api/gateway/chat/completions
PROBE_RESPONSES_PATH=/api/gateway/responses
# Comma-separated models to probe (PROBE_MODEL is the legacy single-model alias).
PROBE_MODELS=nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,dots-studio/dots-3-note-preview:free
# Subset of probe models that use the Responses API shape.
RESPONSES_MODELS=dots-studio/dots-3-note-preview:free
# Model timed for the slow-relay check.
SPEED_MODEL=nvidia/nemotron-3.5-lightning:free
# Slow threshold in ms; 0 disables the speed check.
SLOW_THRESHOLD_MS=0
# Extra rotations when only the speed check fails.
SLOW_MAX_ROTATIONS=2
# Cap on relays rotated for a pool-wide 429 wave. Default is max(8, COUNT-1)
# (9 at COUNT=10): several recycled egress addresses can come up throttled at
# once, and a low guard would mistake that for upstream quota and skip rotation.
GLOBAL_QUOTA_GUARD=9
# Prefix of the WARP client containers (warp-relay-warp-N by default).
CONTAINER_PREFIX=warp-relay-warp-
# How long to wait for a restarted WARP client to report Connected.
READY_TIMEOUT_MS=180000
# Per-probe HTTP timeout in ms.
PROBE_TIMEOUT_MS=30000
# Max tier-1 restarts per relay per pass when probes return 429 (tier 2 runs
# at most once per pass).
MAX_ROTATIONS=4
# Minimum seconds between tier-2 (full re-key) rotations for one relay,
# persisted in TIER2_STATE_FILE; 0 disables the interval gate.
TIER2_MIN_INTERVAL_S=3600
TIER2_STATE_FILE=.keep-cold/tier2-state.json
# Same-egress re-probes before a server_error tier-1, and the relay count at
# which a model counts as an upstream incident instead of an egress fault.
SERVER_ERROR_RETRY=1
SERVER_ERROR_REPROBE_MS=5000
SERVER_ERROR_GUARD=9
# How many relays to rotate concurrently. Concurrent WARP restarts can trip
# Cloudflare registration limits; raise only deliberately.
ROTATE_CONCURRENCY=1
# Host SOCKS port for relay N (default 10800 + N).
# SOCKS_PORT_BASE=10800
# Seconds between passes with --loop.
INTERVAL_S=300
# Optional append-only log file (stdout always logs regardless).
KEEP_COLD_LOG=
# Log rotation caps in bytes.
KEEP_COLD_LOG_MAX_BYTES=2097152
KEEP_COLD_LOG_KEEP_BYTES=204800
