# Copy to .env and adjust. No secrets here — only pool shape and tuning.
#
# Comment syntax: full-line comments start with '#'; after an UNQUOTED value
# a whitespace-preceded '#' also starts an inline comment (e.g.
# `BASE_PORT=3000 # custom`). Quoted values run to the closing quote; a
# comment after the closing quote is ignored.
#
# How these values are consumed:
#   - generate-compose.sh sources this file (when present) at generation
#     time and bakes the relevant values into docker-compose.yml (relay
#     service environment + host binds). After editing, re-run
#     ./generate-compose.sh <count> [--with-tunnels] && docker compose up -d.
#     Values already set in the process environment take precedence.
#   - keep-cold.mjs reads the process environment only. For manual runs use
#     `node --env-file=.env keep-cold.mjs --once`; systemd installs get their
#     values from the unit's Environment= lines (setup.sh writes COUNT
#     there), NOT from this file.

# --- Pool shape ---
# Relay count: generator COUNT, the relay app's RELAY_COUNT, and the
# keep-cold pool size. Relay N listens on BASE_PORT+N; its SOCKS host port
# is 10800+N.
# The setup.sh wizard picks its own count from VPS sizing (pin one with
# `COUNT=5 ./setup.sh`) and intentionally ignores this value, so a copied
# example cannot over-commit a small VPS; manual runs
# (`COUNT=N ./generate-compose.sh`, keep-cold) use it directly. If you
# change it on a wizard-installed host, update the unit's Environment=COUNT
# to match (or re-run setup.sh) — the prober must probe the deployed count.
COUNT=10
# Base port for the relay app's listeners (relay N → BASE_PORT+N). The
# generator derives the tunnel targets, the mesh ingress mapping, and the
# systemd prober's port range from this same value.
BASE_PORT=3000
# Comma-separated allowlist for the x-relay-target header — the relay
# refuses any request whose target is not on this list.
RELAY_ALLOWED_TARGETS=https://opencode.ai,https://api.kilo.ai
# Host binds for the generated compose. Both default to 127.0.0.1 (loopback
# only); set an address explicitly to expose deliberately.
#   WARP_BIND    raw SOCKS5 proxies (10800+N)
#   INGRESS_BIND relay router (3101+; mesh mode only — tunnels mode does not
#                publish it)
# The setup wizard sets INGRESS_BIND to the VPS Tailscale IP in mesh mode.
# WARP_BIND=127.0.0.1
# INGRESS_BIND=127.0.0.1

# --- server.mjs per-relay upstream override (defaults: warp-N:1080) ---
# WARP_HOST_1=warp-1
# WARP_PORT_1=1080

# --- keep-cold probe (keep-cold.mjs) ---
# Address of the relay app as seen from the deploy host.
RELAY_HOST=10.244.0.100
# Host dialed for the SOCKS readiness/egress probes. Keep the default unless
# WARP_BIND is an interface-specific address (then loopback has no listener);
# 0.0.0.0 binds still answer on loopback.
# LEGACY: accepted but no longer drives a post-restart wait; a restarted relay
# is simply skipped until EGRESS_SETTLE_S has passed.
# SOCKS_HOST=127.0.0.1
# Upstream the probes go through (default https://api.kilo.ai — the Kilo
# gateway, keyless-capable and rate-limited per egress; OpenCode's Zen free
# tier refuses non-OpenCode clients outright since 2026-10-14).
PROBE_TARGET=https://api.kilo.ai
PROBE_CHAT_PATH=/api/gateway/chat/completions
PROBE_RESPONSES_PATH=/api/gateway/responses
# Comma-separated models to probe (PROBE_MODEL is the legacy single-model alias).
PROBE_MODELS=nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,dots-studio/dots-3-note-preview:free
# Subset of probe models that use the Responses API shape.
RESPONSES_MODELS=dots-studio/dots-3-note-preview:free
# Model timed for the slow-relay check.
SPEED_MODEL=nvidia/nemotron-3.5-lightning:free
# Slow threshold in ms; 0 disables the speed check.
SLOW_THRESHOLD_MS=0
# LEGACY: speed rotation is disabled and the per-pass rotation loop is gone;
# SLOW_THRESHOLD_MS=0 already means this never fires.
SLOW_MAX_ROTATIONS=2
# Cap on relays rotated for a pool-wide 429 wave. Default is max(8, COUNT-1)
# (9 at COUNT=10): several recycled egress addresses can come up throttled at
# once, and a low guard would mistake that for upstream quota and skip rotation.
GLOBAL_QUOTA_GUARD=9
# Prefix of the WARP client containers (warp-relay-warp-N by default).
CONTAINER_PREFIX=warp-relay-warp-
# LEGACY: accepted and ignored for verification. The scheduler never waits
# inline for a restarted client; it marks the relay pendingVerify and probes it
# again after EGRESS_SETTLE_S. Raise it only if an old controller still runs.
# READY_TIMEOUT_MS=180000
# Per-probe HTTP timeout in ms.
PROBE_TIMEOUT_MS=30000
# LEGACY: accepted but no longer used — a pass makes at most one restart per
# relay, gated by RELAY_COOLDOWN_S and RELAY_MAX_ROTATIONS_PER_HOUR below.
# MAX_ROTATIONS=4
# Minimum seconds between tier-2 (full re-key) rotations for one relay,
# persisted in TIER2_STATE_FILE; 0 disables the interval gate.
TIER2_MIN_INTERVAL_S=3600
TIER2_STATE_FILE=.keep-cold/tier2-state.json
# Same-egress re-probes before a server_error tier-1, and the relay count at
# which a model counts as an upstream incident instead of an egress fault.
SERVER_ERROR_RETRY=1
SERVER_ERROR_REPROBE_MS=5000
SERVER_ERROR_GUARD=9
# How many relays to rotate concurrently. Concurrent WARP restarts can trip
# Cloudflare registration limits; raise only deliberately.
ROTATE_CONCURRENCY=1
# LEGACY: accepted and ignored. The scheduler no longer dials a per-relay SOCKS
# port (readiness is inferred from a later probe), so there is nothing to point
# at a non-default base.
# SOCKS_PORT_BASE=10800
# Seconds between passes with --loop.
INTERVAL_S=300
# Optional append-only log file (stdout always logs regardless).
KEEP_COLD_LOG=
# Log rotation caps in bytes.
KEEP_COLD_LOG_MAX_BYTES=2097152
KEEP_COLD_LOG_KEEP_BYTES=204800

# --- keep-cold scheduler: demand-driven probing + rotation budget ---
# A pass no longer probes the whole pool. After a one-time baseline sweep (no
# state file yet) it probes only: relays marked pendingVerify past
# EGRESS_SETTLE_S, relays still dirty whose cooldown expired, and a rotating
# sample of PROBE_AUDIT_SAMPLE clean relays — so an idle pool costs a couple of
# inference requests per pass instead of COUNT x len(PROBE_MODELS).
#
# Per-relay state. Written by keep-cold only; gitignored. If it is corrupt or
# unwritable the pass still completes, degrading to a baseline sweep. Deleting
# it is safe — the next pass re-learns the pool.
RELAY_STATE_FILE=.keep-cold/state.json
# Minimum seconds between two rotations of the SAME relay. Keeps a persistent
# 429 from restarting one container on every pass (the old attempt 1/4 then
# attempt 2/4 burst). Other relays are unaffected.
RELAY_COOLDOWN_S=600
# Consecutive failures multiply the cooldown: max(RELAY_BACKOFF_BASE_S * 2^(n-1),
# capped at RELAY_BACKOFF_MAX_S). Prevents a genuinely bad egress from burning
# the hourly budget in a handful of passes.
RELAY_BACKOFF_BASE_S=300
RELAY_BACKOFF_MAX_S=3600
# Hard cap on restarts of one relay in a rolling hour, independent of cooldown.
# 0 would mean "never rotate" — leave it above zero on a keyless pool.
RELAY_MAX_ROTATIONS_PER_HOUR=2
# Clean relays probed per pass (round-robin) to catch throttles that live
# traffic has not reported yet. 0 makes the pool invisible until something
# fails; the whole-pool baseline sweep happens only once, on the first pass.
PROBE_AUDIT_SAMPLE=2
# Seconds after a restart before the relay is probed again. Probing inside the
# WARP handshake is what produced false 429s and back-to-back restarts; a
# restarted relay is treated as throttled-free for this window.
EGRESS_SETTLE_S=150
# Milliseconds between docker restart calls. Serialised regardless of
# ROTATE_CONCURRENCY so a slow HDD is not asked for two container
# stop/starts at once.
ROTATE_SPACING_MS=4000
# Parallel probes per pass. Probes are inference requests, not restarts.
PROBE_CONCURRENCY=4
#
# Live 429 signals (phase 2). When the relay app is built with the signal
# writer, it appends one record per (relay, model) state change and keep-cold
# rotates that named relay without probing at all. Two SIDES, two paths:
#   - relay app (container): LIVE_SIGNALS=1 and LIVE_SIGNAL_FILE=/signals/signals.json
#     as baked by generate-compose.sh; the container path exists only because
#     the compose file bind-mounts ./.keep-cold:/signals.
#   - keep-cold (host): reads the same file through the HOST path
#     .keep-cold/signals.json; this file is also the fallback trigger for
#     `node --env-file=.env keep-cold.mjs`.
# LIVE_SIGNALS=1 needs BOTH a rebuilt relay image (server.mjs is COPY-baked, so
# `docker compose build relay && docker compose up -d relay`, never a bare
# restart) and the compose mount. Both processes read this switch separately:
# generate-compose.sh bakes it into the relay container, and the host
# keep-cold run must also see LIVE_SIGNALS=1 (unit Environment=, or
# `--env-file=.env` for a manual run) — one side alone changes nothing.
# Without either, the file never appears and the probe scheduler above runs
# unchanged — signals are an optimisation, never a requirement.
LIVE_SIGNALS=0
# LIVE_SIGNAL_FILE has two different values and they are not interchangeable:
#   - container side: /signals/signals.json — the default hard-coded in
#     generate-compose.sh, valid ONLY because the relay service bind-mounts
#     ./.keep-cold:/signals. Leave this file's value unset so that default wins;
#     a host path here would be baked into the container and match nothing.
#   - host side (keep-cold): .keep-cold/signals.json — pass it in the unit's
#     Environment= line or with `--env-file`, never through .env at
#     generation time.
# Keep-cold consumes the file destructively (rewrites {"signals":[]}) only when
# LIVE_SIGNALS=1; with 0 it never opens it. A missing or corrupt file is simply
# "no signals", never an error.
# LIVE_SIGNAL_FILE=.keep-cold/signals.json
